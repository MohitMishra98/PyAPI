# Application Settings
PROJECT_NAME="FastAPI Production Template"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Frontend URL (For generating verification & password reset links)
FRONTEND_URL="http://localhost:3000"

# Security & JWT
SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMAIL_RESET_TOKEN_EXPIRE_HOURS=2
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24

# Database
# PostgreSQL (e.g. Neon, AWS RDS, local postgres) or SQLite
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# CORS (JSON string array or comma separated list)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000"]'

# Email / SMTP Credentials (Required for sending emails - e.g. Gmail, SendGrid, Amazon SES)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="your-email@gmail.com"
EMAILS_FROM_NAME="FastAPI Production Template"
